{
  "name": "dsh-plugin-zen-runtime",
  "version": "0.1.0",
  "description": "Runtime-only fix for the OpenCode Zen free tier in dsh: restores the opencode User-Agent and the x-opencode-* identity headers on the wire and appends the bash and read tool stubs the Zen gateway requires, without patching any file on disk.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "zen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jason2be/dsh-plugin-zen-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/jason2be/dsh-plugin-zen-runtime/issues"
  },
  "homepage": "https://github.com/jason2be/dsh-plugin-zen-runtime#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/runtime.spec.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
